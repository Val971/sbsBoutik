---
import Layout from './Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import WhatsAppFloat from '../components/WhatsAppFloat.astro'
import BackToTop from '../components/BackToTop.astro'
import { LEGAL } from '../config/legal'
import { getLang, home } from '../i18n'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
const lang = getLang(Astro.currentLocale)
const t = {
  fr: { back: '← Retour à l\'accueil', eyebrow: 'Informations légales', updated: 'Dernière mise à jour :' },
  en: { back: '← Back to home', eyebrow: 'Legal information', updated: 'Last updated:' },
}[lang]
const updated = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', { dateStyle: 'long' }).format(new Date(LEGAL.lastUpdate))
---

<Layout title={`${title} | SBS – Sainte-Anne Bureautique Services`} description={description}>
  <Navbar />
  <main class="legal">
    <div class="container">
      <header class="legal-head">
        <a href={home(lang)} class="back">{t.back}</a>
        <span class="eyebrow">{t.eyebrow}</span>
        <h1 class="section-title">{title}</h1>
        <p class="updated">{t.updated} {updated}</p>
      </header>
      <article class="legal-body">
        <slot />
      </article>
    </div>
  </main>
  <Footer />
  <BackToTop />
  <WhatsAppFloat />
</Layout>

<style>
  .legal {
    padding-block: 64px 96px;
    background: var(--light);
  }
  .legal-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    max-width: 820px;
    margin: 0 auto 32px;
  }
  .back {
    font-size: 14px;
    font-weight: 600;
    color: var(--primary);
  }
  .updated {
    font-size: 14px;
    color: var(--muted);
  }
  .legal-body {
    max-width: 820px;
    margin: 0 auto;
    padding: 40px 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .legal-body :global(h2) {
    margin: 36px 0 12px;
    font-size: 22px;
  }
  .legal-body :global(h2:first-child) {
    margin-top: 0;
  }
  .legal-body :global(p),
  .legal-body :global(li) {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text);
  }
  .legal-body :global(p + p) {
    margin-top: 10px;
  }
  .legal-body :global(ul) {
    margin: 10px 0;
    padding-left: 20px;
    list-style: disc;
  }
  .legal-body :global(dl) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .legal-body :global(dl > div) {
    display: grid;
    gap: 2px 16px;
    padding: 12px 16px;
  }
  .legal-body :global(dl > div + div) {
    border-top: 1px solid var(--border);
  }
  .legal-body :global(dt) {
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .legal-body :global(dd) {
    margin: 0;
    color: var(--dark);
  }
  .legal-body :global(a) {
    color: var(--primary);
    font-weight: 600;
  }
  .legal-body :global(.todo) {
    padding: 2px 8px;
    font-size: 14px;
    font-weight: 700;
    color: #8a5a00;
    background: #fff3cd;
    border-radius: 6px;
  }
  @media (min-width: 768px) {
    .legal-body {
      padding: 56px;
    }
    .legal-body :global(dl > div) {
      grid-template-columns: 220px 1fr;
    }
  }
</style>
