---
const svg = (body) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`

const icons = {
  print: svg('<path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8" rx="1"/>'),
  repair: svg('<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/><circle cx="12" cy="10" r="2.2"/><path d="M12 6.3v1.5M12 12.2v1.5M8.3 10h1.5M14.2 10h1.5"/>'),
  wallet: svg('<path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/>'),
  phone: svg('<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/><path d="M9 8h6M9 11h4"/>'),
}

import { getLang } from '../i18n'

const lang = getLang(Astro.currentLocale)
const t = {
  fr: {
    copy: ['Copies & Impression', 'Couleur · N&B · A3'],
    repair: ['Réparation PC', 'Diagnostic rapide'],
    nickel: ['Point Nickel', 'Compte pour tous'],
    yem: ['YEM Pay', 'Paiement mobile'],
    clients: 'clients satisfaits',
  },
  en: {
    copy: ['Copying & Printing', 'Color · B&W · A3'],
    repair: ['PC Repair', 'Quick diagnosis'],
    nickel: ['Nickel', 'An account for everyone'],
    yem: ['YEM Pay', 'Mobile payment'],
    clients: 'happy customers',
  },
}[lang]

const chips = [
  { cls: 'chip-1', tone: 'red', icon: icons.print, title: t.copy[0], sub: t.copy[1] },
  { cls: 'chip-2', tone: 'teal', icon: icons.repair, title: t.repair[0], sub: t.repair[1] },
  { cls: 'chip-3', tone: 'nickel', icon: icons.wallet, title: t.nickel[0], sub: t.nickel[1] },
  { cls: 'chip-4', tone: 'yem', icon: icons.phone, title: t.yem[0], sub: t.yem[1] },
]
---

<div class="hm-stage" aria-hidden="true">
  <div class="hm-halo"></div>
  <div class="hm-ring hm-ring-outer"><span class="hm-dot hm-dot-a"></span><span class="hm-dot hm-dot-b"></span></div>
  <div class="hm-ring hm-ring-inner"><span class="hm-dot hm-dot-c"></span></div>

  <div class="hm-core">
    <img src="/logoSbs2020.png" alt="" width="104" height="104" />
  </div>

  {chips.map((c) => (
    <div class={`hm-chip hm-${c.cls}`}>
      <span class={`hm-chip-icon ${c.tone}`} set:html={c.icon}></span>
      <span class="hm-chip-text"><strong>{c.title}</strong><small>{c.sub}</small></span>
    </div>
  ))}

  <div class="hm-sheet">
    <span class="hm-line l1"></span>
    <span class="hm-line l2"></span>
    <span class="hm-line l3"></span>
    <span class="hm-stamp">SBS</span>
  </div>

  <div class="hm-stat">
    <strong>500+</strong>
    <small>{t.clients}</small>
  </div>
</div>

<style>
  .hm-stage {
    position: relative;
    width: min(460px, 82vw);
    aspect-ratio: 1;
    font-family: var(--font);
  }
  .hm-halo,
  .hm-ring,
  .hm-core {
    position: absolute;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    translate: -50% -50%;
  }
  .hm-halo {
    width: 46%;
    height: 46%;
    background: radial-gradient(circle, rgba(196, 30, 58, 0.35) 0%, rgba(196, 30, 58, 0) 70%);
    animation: hm-halo 3.2s ease-out infinite;
  }
  .hm-ring {
    border: 1.5px dashed rgba(27, 94, 117, 0.35);
  }
  .hm-ring-outer {
    width: 86%;
    height: 86%;
    animation: hm-spin 34s linear infinite;
  }
  .hm-ring-inner {
    width: 60%;
    height: 60%;
    border-style: solid;
    border-color: rgba(196, 30, 58, 0.18);
    animation: hm-spin 22s linear infinite reverse;
  }
  .hm-dot {
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.8);
  }
  .hm-dot-a { top: -6px; left: calc(50% - 6px); background: var(--primary); }
  .hm-dot-b { bottom: 12%; right: 6%; width: 9px; height: 9px; background: var(--secondary); }
  .hm-dot-c { top: calc(50% - 5px); left: -5px; width: 10px; height: 10px; background: var(--secondary); }

  .hm-core {
    width: 38%;
    height: 38%;
    display: grid;
    place-items: center;
    background: var(--white);
    box-shadow:
      0 20px 50px rgba(196, 30, 58, 0.25),
      inset 0 0 0 6px rgba(196, 30, 58, 0.06);
    animation: hm-breathe 4s ease-in-out infinite;
  }
  .hm-core img {
    width: 74%;
    height: auto;
    object-fit: contain;
  }

  .hm-chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    background: var(--glass);
    backdrop-filter: blur(8px);
    border-radius: 16px;
    box-shadow: 0 14px 34px rgba(26, 26, 26, 0.12);
    white-space: nowrap;
    animation:
      hm-in 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.3) both,
      hm-bob 5s ease-in-out infinite;
  }
  .hm-chip-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .hm-chip strong {
    font-size: 13px;
    font-weight: 600;
    color: var(--dark);
  }
  .hm-chip small {
    font-size: 11px;
    color: #7a7b8c;
  }
  .hm-chip-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 11px;
    color: var(--white);
  }
  .hm-chip-icon :global(svg) {
    width: 20px;
    height: 20px;
  }
  .hm-chip-icon.red { background: linear-gradient(135deg, #E04558, var(--primary)); }
  .hm-chip-icon.teal { background: linear-gradient(135deg, #2A8CAD, var(--secondary)); }
  .hm-chip-icon.nickel { background: var(--nickel); }
  .hm-chip-icon.yem { background: var(--yempay-bg); color: var(--yempay-gold); }

  .hm-chip-1 { top: 4%; left: -6%; animation-delay: 0.3s, 1s; }
  .hm-chip-2 { top: 20%; right: -8%; animation-delay: 0.5s, 2.2s; }
  .hm-chip-3 { bottom: 22%; left: -10%; animation-delay: 0.7s, 0.4s; }
  .hm-chip-4 { bottom: 4%; right: -2%; animation-delay: 0.9s, 3s; }

  .hm-sheet {
    position: absolute;
    top: 7%;
    right: 22%;
    width: 64px;
    height: 82px;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    background: var(--white);
    border-radius: 6px;
    box-shadow: 0 10px 24px rgba(26, 26, 26, 0.14);
    rotate: 8deg;
    animation: hm-print 6s ease-in-out infinite;
  }
  .hm-line {
    height: 4px;
    border-radius: 2px;
    background: #d9dce6;
    transform-origin: left;
    animation: hm-write 6s ease-in-out infinite;
  }
  .hm-line.l1 { width: 100%; background: rgba(27, 94, 117, 0.45); }
  .hm-line.l2 { width: 80%; animation-delay: 0.2s; }
  .hm-line.l3 { width: 60%; animation-delay: 0.4s; }
  .hm-stamp {
    position: absolute;
    right: 6px;
    bottom: 6px;
    padding: 2px 4px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--primary);
    border: 1.5px solid var(--primary);
    border-radius: 4px;
    rotate: -12deg;
    animation: hm-stamp 6s ease-in-out infinite;
  }

  .hm-stat {
    position: absolute;
    left: 24%;
    bottom: -2%;
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding: 8px 14px;
    background: var(--secondary);
    color: var(--white);
    border-radius: 999px;
    box-shadow: 0 12px 28px rgba(27, 94, 117, 0.35);
    animation:
      hm-in 0.7s cubic-bezier(0.2, 0.9, 0.3, 1.3) 1.1s both,
      hm-bob 6s ease-in-out 1.6s infinite;
  }
  .hm-stat strong { font-size: 16px; }
  .hm-stat small { font-size: 11px; opacity: 0.85; }

  @keyframes hm-spin { to { rotate: 360deg; } }
  @keyframes hm-halo {
    0% { scale: 0.9; opacity: 0.9; }
    100% { scale: 2.2; opacity: 0; }
  }
  @keyframes hm-breathe {
    0%, 100% { scale: 1; }
    50% { scale: 1.04; }
  }
  @keyframes hm-in {
    from { opacity: 0; scale: 0.6; }
    to { opacity: 1; scale: 1; }
  }
  @keyframes hm-bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -10px; }
  }
  @keyframes hm-print {
    0% { clip-path: inset(0 0 100% 0); translate: 0 -10px; opacity: 1; }
    25%, 85% { clip-path: inset(0 0 0 0); translate: 0 0; opacity: 1; }
    100% { clip-path: inset(0 0 0 0); translate: 0 0; opacity: 0; }
  }
  @keyframes hm-write {
    0%, 25% { scale: 0 1; }
    45%, 100% { scale: 1 1; }
  }
  @keyframes hm-stamp {
    0%, 50% { opacity: 0; scale: 1.8; }
    58%, 100% { opacity: 1; scale: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hm-stage,
    .hm-stage * {
      animation: none !important;
    }
  }

  @media (max-width: 600px) {
    .hm-chip { padding: 7px 10px 7px 7px; gap: 8px; }
    .hm-chip-icon { width: 28px; height: 28px; border-radius: 9px; }
    .hm-chip-icon :global(svg) { width: 16px; height: 16px; }
    .hm-chip strong { font-size: 11px; }
    .hm-chip small { display: none; }
    .hm-chip-1 { left: -2%; }
    .hm-chip-2 { right: -2%; }
    .hm-chip-3 { left: -4%; }
    .hm-sheet { width: 48px; height: 62px; padding: 9px 7px; gap: 5px; }
  }
</style>
