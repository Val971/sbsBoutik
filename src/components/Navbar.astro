---
import { getLang, home, LANGS, PAGES, pageKeyFromPath } from '../i18n'
import { telHref } from '../config/contact'

const lang = getLang(Astro.currentLocale)
const t = {
  fr: {
    services: 'Services', about: 'À propos', contact: 'Contact', call: 'Appelez-nous',
    brandAria: 'Sainte-Anne Bureautique Services – accueil', nav: 'Principal',
    menuOpen: 'Ouvrir le menu', menuClose: 'Fermer le menu',
    darkOn: 'Activer le mode sombre', lightOn: 'Activer le mode clair', themeTitle: 'Mode sombre / clair',
    langLabel: 'Choisir la langue',
  },
  en: {
    services: 'Services', about: 'About', contact: 'Contact', call: 'Call us',
    brandAria: 'Sainte-Anne Bureautique Services – home', nav: 'Main',
    menuOpen: 'Open menu', menuClose: 'Close menu',
    darkOn: 'Switch to dark mode', lightOn: 'Switch to light mode', themeTitle: 'Dark / light mode',
    langLabel: 'Choose language',
  },
}[lang]

const links = [
  { label: t.services, href: home(lang, 'services') },
  { label: 'Nickel & YEM Pay', href: home(lang, 'partenaires') },
  { label: t.about, href: home(lang, 'about') },
  { label: t.contact, href: '#contact' },
]
const pageKey = pageKeyFromPath(Astro.url.pathname)
const langNames = { fr: 'Français', en: 'English' }
---

<header class="nav">
  <div class="container nav-inner">
    <a href={home(lang)} class="brand" aria-label={t.brandAria}>
      <img src="/logoSbs2020.png" alt="" class="brand-logo" width="48" height="48" />
      <span class="brand-text">
        <strong>Sainte-Anne</strong>
        <small>Bureautique Services</small>
      </span>
    </a>

    <nav class="lang-switch" aria-label={t.langLabel}>
      {LANGS.map((l) => (
        <a
          href={PAGES[pageKey][l]}
          hreflang={l}
          lang={l}
          title={langNames[l]}
          aria-current={l === lang ? 'true' : undefined}
          class:list={['lang-link', { active: l === lang }]}
        >{l.toUpperCase()}</a>
      ))}
    </nav>

    <button
      class="theme-toggle"
      type="button"
      aria-label={t.darkOn}
      title={t.themeTitle}
      data-label-dark={t.darkOn}
      data-label-light={t.lightOn}
    >
      <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>

    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label={t.menuOpen}
      data-label-open={t.menuOpen}
      data-label-close={t.menuClose}
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="nav-menu" class="menu" aria-label={t.nav}>
      <ul class="menu-list">
        {links.map((l) => (
          <li><a href={l.href} class="menu-link">{l.label}</a></li>
        ))}
      </ul>
      <a href={telHref} class="btn btn-primary btn-sm">{t.call}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')
  const menu = document.querySelector<HTMLElement>('.menu')
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open))
    toggle?.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '')
    menu?.classList.toggle('is-open', open)
  }
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'))
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)))

  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-toggle')
  const syncThemeBtn = () => {
    const dark = document.documentElement.dataset.theme === 'dark'
    themeBtn?.setAttribute('aria-label', (dark ? themeBtn.dataset.labelLight : themeBtn.dataset.labelDark) ?? '')
    themeBtn?.setAttribute('aria-pressed', String(dark))
  }
  syncThemeBtn()
  themeBtn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    try { localStorage.setItem('theme', next) } catch {}
    syncThemeBtn()
  })
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let stored = null
    try { stored = localStorage.getItem('theme') } catch {}
    if (stored) return
    document.documentElement.dataset.theme = e.matches ? 'dark' : 'light'
    syncThemeBtn()
  })

  const nav = document.querySelector<HTMLElement>('.nav')
  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8)
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .nav.is-scrolled {
    border-color: var(--border);
    box-shadow: 0 6px 24px rgba(22, 22, 28, 0.06);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 76px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
  }
  .brand-logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 50%;
    transition: transform 0.3s ease;
  }
  .lang-switch {
    display: flex;
    padding: 3px;
    border-radius: var(--radius-sm);
    background: var(--light);
    border: 1px solid var(--border);
  }
  .lang-link {
    display: grid;
    place-items: center;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--muted);
    border-radius: 9px;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .lang-link:hover {
    color: var(--dark);
  }
  .lang-link.active {
    color: var(--white);
    background: var(--primary);
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    padding: 0;
    color: var(--dark);
    background: var(--light);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .theme-toggle:hover {
    color: var(--primary);
    transform: rotate(-12deg);
  }
  .theme-toggle .icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .icon-sun {
    display: block;
  }
  :global([data-theme='dark']) .theme-toggle .icon-moon {
    display: none;
  }
  .brand:hover .brand-logo {
    transform: rotate(-8deg) scale(1.05);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand-text strong {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .brand-text small {
    font-size: 12px;
    color: var(--muted);
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 11px;
    background: var(--light);
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .menu-toggle span {
    display: block;
    height: 2px;
    background: var(--dark);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .menu-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .menu {
    display: none;
    position: absolute;
    top: 76px;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 16px;
    padding: 16px 20px 24px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 20px 40px rgba(22, 22, 28, 0.08);
  }
  .menu.is-open {
    display: flex;
  }
  .menu-list {
    display: flex;
    flex-direction: column;
  }
  .menu-link {
    position: relative;
    display: block;
    padding: 12px 0;
    font-size: 16px;
    font-weight: 500;
    color: var(--dark);
    transition: color 0.2s ease;
  }
  .menu-link:hover {
    color: var(--primary);
  }

  @media (max-width: 420px) {
    .brand-text {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }
    .lang-switch {
      order: 2;
    }
    .theme-toggle {
      order: 3;
    }
    .menu {
      display: flex;
      position: static;
      flex-direction: row;
      align-items: center;
      gap: 28px;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
    }
    .menu-list {
      flex-direction: row;
      align-items: center;
      gap: 30px;
    }
    .menu-link {
      padding: 8px 0;
      font-size: 15px;
    }
    .menu-link::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 2px;
      height: 2px;
      border-radius: 2px;
      background: var(--primary);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s ease;
    }
    .menu-link:hover::after {
      transform: scaleX(1);
    }
  }
</style>
