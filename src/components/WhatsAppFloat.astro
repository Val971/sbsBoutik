---
import { whatsappHref, WHATSAPP_ICON } from '../config/contact'
---

<a
  class="wa-float"
  href={whatsappHref('Bonjour SBS, je souhaite avoir des informations.')}
  target="_blank"
  rel="noopener"
  aria-label="Nous écrire sur WhatsApp"
>
  <span class="wa-ping" aria-hidden="true"></span>
  <span class="wa-icon" set:html={WHATSAPP_ICON.replace('width="22" height="22"', 'width="30" height="30"')}></span>
  <span class="wa-label">Écrivez-nous sur WhatsApp</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 60;
    display: flex;
    align-items: center;
    height: 60px;
    padding: 0 15px;
    border-radius: 999px;
    color: #fff;
    background: #25D366;
    box-shadow: 0 14px 30px rgba(37, 211, 102, 0.4);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .wa-float:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 36px rgba(37, 211, 102, 0.5);
  }
  .wa-icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
  }
  .wa-label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 14px;
    font-weight: 600;
    transition: max-width 0.35s ease, margin 0.35s ease;
  }
  .wa-float:hover .wa-label,
  .wa-float:focus-visible .wa-label {
    max-width: 220px;
    margin: 0 6px 0 10px;
  }
  .wa-ping {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: #25D366;
    animation: wa-ping 2.4s ease-out infinite;
  }
  @keyframes wa-ping {
    0% { scale: 1; opacity: 0.55; }
    100% { scale: 1.5; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-ping { animation: none; }
  }
  @media (min-width: 768px) {
    .wa-float {
      right: 28px;
      bottom: 28px;
    }
  }
</style>
