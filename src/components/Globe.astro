---
import { MAPS_URL } from '../config/contact'
import { getLang, PAGES } from '../i18n'

const lang = getLang(Astro.currentLocale)
const t = {
  fr: {
    photoAlt: 'Devanture de Sainte-Anne Bureautique Services : vitrine rouge et blanche, enseigne SBS 0590 88 27 27',
    storeChip: 'Repérez notre vitrine rouge et blanche',
    consentTitle: 'Voir la boutique sur la carte',
    consentText: 'La carte est fournie par Google Maps, qui peut déposer des cookies.',
    learnMore: 'En savoir plus',
    showMap: 'Afficher la carte',
    mapTitle: 'Carte Google Maps - Sainte-Anne Bureautique Services, Sainte-Anne, Guadeloupe',
    badgeSub: 'Notre boutique, au cœur de la Grande-Terre',
    directions: 'Itinéraire',
    eyebrow: 'Nous trouver',
    title: ['Au cœur de ', 'Sainte-Anne', ', au service de toute la Guadeloupe'],
    text: 'Depuis plus de 30 ans, SBS accompagne les entreprises et particuliers de Guadeloupe dans leurs besoins bureautiques, services financiers et numériques. Nous sommes votre partenaire de confiance pour tous vos projets.',
    stats: [['500+', 'Clients en Guadeloupe'], ['30+', 'Ans d\'expérience']],
    cta: 'Découvrir nos services',
  },
  en: {
    photoAlt: 'Sainte-Anne Bureautique Services storefront: red and white shop window, SBS sign 0590 88 27 27',
    storeChip: 'Look for our red and white storefront',
    consentTitle: 'See the store on the map',
    consentText: 'The map is provided by Google Maps, which may set cookies.',
    learnMore: 'Learn more',
    showMap: 'Show map',
    mapTitle: 'Google Map - Sainte-Anne Bureautique Services, Sainte-Anne, Guadeloupe',
    badgeSub: 'Our store, in the heart of Grande-Terre',
    directions: 'Directions',
    eyebrow: 'Find us',
    title: ['In the heart of ', 'Sainte-Anne', ', serving all of Guadeloupe'],
    text: 'For over 30 years, SBS has been helping businesses and individuals in Guadeloupe with their office, financial and digital needs. We are your trusted partner for all your projects.',
    stats: [['500+', 'Customers in Guadeloupe'], ['30+', 'Years of experience']],
    cta: 'Explore our services',
  },
}[lang]
const stats = t.stats.map(([value, label]) => ({ value, label }))
---

<section id="zone" class="globe">
  <div class="container grid">
    <div class="visual reveal">
    <figure class="storefront">
      <img
        src="/images/devanture-sbs-1200.webp"
        srcset="/images/devanture-sbs-700.webp 700w, /images/devanture-sbs-1200.webp 1200w"
        sizes="(min-width: 992px) 600px, 100vw"
        alt={t.photoAlt}
        width="1200"
        height="477"
        loading="lazy"
      />
      <figcaption class="store-chip">
        <span class="store-dot" aria-hidden="true"></span>
        {t.storeChip}
      </figcaption>
    </figure>
    <div class="map-wrap">
      <div class="map map-consent" data-map-consent>
        <div class="consent-inner">
          <span class="consent-pin" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <p class="consent-title">{t.consentTitle}</p>
          <p class="consent-text">{t.consentText} <a href={PAGES.privacy[lang]}>{t.learnMore}</a></p>
          <button type="button" class="btn btn-primary btn-sm" data-map-load>{t.showMap}</button>
        </div>
        <template>
          <iframe
            class="map"
            title={t.mapTitle}
            src="https://www.google.com/maps?q=16.224742,-61.383377&z=16&output=embed"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </template>
      </div>
      <div class="map-badge">
        <img src="/logoSbs2020.png" alt="" width="40" height="40" />
        <div>
          <strong>SBS — Sainte-Anne</strong>
          <span>{t.badgeSub}</span>
        </div>
        <a class="map-open" href={MAPS_URL} target="_blank" rel="noopener">{t.directions} ↗</a>
      </div>
    </div>
    </div>
    <div class="content reveal" style="--delay: 120ms">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="section-title">{t.title[0]}<span>{t.title[1]}</span>{t.title[2]}</h2>
      <p>{t.text}</p>
      <dl class="stats">
        {stats.map((s) => (
          <div>
            <dt class="sr-only">{s.label}</dt>
            <dd class="value">{s.value}</dd>
            <dd class="label" aria-hidden="true">{s.label}</dd>
          </div>
        ))}
      </dl>
      <a href="#services" class="btn btn-primary">{t.cta}</a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-map-consent]').forEach((box) => {
    box.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const tpl = box.querySelector('template')
      if (tpl) box.replaceWith(tpl.content.cloneNode(true))
    })
  })
</script>

<style>
  .globe {
    padding-block: 96px;
  }
  .grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  .visual {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }
  .storefront {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 6px solid var(--surface);
    box-shadow: var(--shadow-lg);
  }
  .storefront img {
    width: 100%;
    aspect-ratio: 1200 / 477;
    object-fit: cover;
    border-radius: 22px;
    transition: scale 0.6s ease;
  }
  .storefront:hover img {
    scale: 1.03;
  }
  .store-chip {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--on-white);
    background: rgba(255, 255, 255, 0.95);
    border-radius: 999px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
  }
  .store-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary);
    box-shadow: 0 0 0 4px rgba(196, 30, 58, 0.2);
  }
  .map-wrap {
    width: 100%;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    border: 6px solid var(--surface);
  }
  .map,
  .map-wrap :global(iframe) {
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 0;
    border-radius: 22px;
    display: block;
  }
  .map-consent {
    display: grid;
    place-items: center;
    padding: 24px;
    text-align: center;
    background:
      radial-gradient(circle at 50% 40%, rgba(196, 30, 58, 0.08), transparent 60%),
      repeating-linear-gradient(0deg, transparent 0 23px, rgba(27, 94, 117, 0.06) 23px 24px),
      repeating-linear-gradient(90deg, transparent 0 23px, rgba(27, 94, 117, 0.06) 23px 24px),
      var(--light);
  }
  .consent-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    max-width: 360px;
  }
  .consent-pin {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    color: var(--white);
    background: var(--grad-primary);
    box-shadow: 0 12px 24px rgba(196, 30, 58, 0.28);
  }
  .consent-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--dark);
  }
  .consent-text {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text);
  }
  .consent-text a {
    color: var(--primary);
    font-weight: 600;
  }
  .map-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px 10px;
  }
  .map-badge img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  .map-badge strong {
    display: block;
    font-size: 14px;
    color: var(--dark);
  }
  .map-badge span {
    font-size: 12px;
    color: #6b6c80;
  }
  .map-open {
    margin-left: auto;
    flex-shrink: 0;
    padding: 9px 14px;
    background: var(--primary);
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    transition: transform 0.2s ease;
  }
  .map-open:hover {
    transform: translateY(-2px);
  }
  @media (max-width: 520px) {
    .map,
    .map-wrap :global(iframe) {
      aspect-ratio: 1 / 1;
    }
    .store-chip {
      left: 10px;
      bottom: 10px;
      font-size: 12px;
    }
  }
  @media (min-width: 992px) {
    .map,
    .map-wrap :global(iframe) {
      aspect-ratio: 16 / 9;
    }
  }
  .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  h2 {
    max-width: 520px;
  }
  .content > p {
    font-size: 18px;
    line-height: 1.55;
    color: var(--text);
    max-width: 480px;
  }
  .stats {
    display: flex;
    gap: 16px;
    margin: 8px 0;
  }
  .stats > div {
    padding: 18px 22px;
    border-radius: var(--radius);
    background: var(--light);
    border: 1px solid var(--border);
  }
  dd {
    margin: 0;
  }
  .value {
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--primary);
  }
  .label {
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
  }

  @media (min-width: 992px) {
    .globe {
      padding-block: 120px;
    }
    .grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 80px;
    }
  }
</style>
