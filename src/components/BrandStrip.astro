---
const brands = [
  { name: 'Canon', logo: '/images/brands/canon.png' },
  { name: 'Samsung', logo: '/images/brands/samsung.png' },
  { name: 'HP', logo: '/images/brands/hp.png', square: true },
  { name: 'Nickel', logo: '/images/partners/nickel-logo.png', square: true },
  { name: 'Lenovo', logo: '/images/brands/lenovo.png' },
  { name: 'Epson', logo: '/images/brands/epson.png' },
]
const loop = [...brands, ...brands]
import { getLang } from '../i18n'
const lang = getLang(Astro.currentLocale)
const label = { fr: 'Nos partenaires et marques', en: 'Our partners and brands' }[lang]
---

<section class="brands" aria-labelledby="brands-title">
  <div class="container">
    <p id="brands-title" class="label">{label}</p>
  </div>
  <div class="marquee">
    <ul class="track">
      {loop.map((b, i) => (
        <li class="brand" aria-hidden={i >= brands.length ? 'true' : undefined}>
          {b.logo ? (
            <img
              src={b.logo}
              alt={b.name}
              class:list={[{ square: b.square }]}
              height="40"
              loading="lazy"
            />
          ) : (
            <span class="wordmark">{b.name}</span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .brands {
    padding-block: 40px 56px;
    background: var(--bg);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .label {
    margin-bottom: 24px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .track {
    display: flex;
    width: max-content;
    gap: 20px;
    animation: scroll 28s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .brand {
    display: grid;
    place-items: center;
    min-width: 170px;
    height: 76px;
    padding: 0 28px;
    border-radius: var(--radius);
    background: var(--brand-tile);
    border: 1px solid var(--border);
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .brand:hover {
    background: var(--white);
    border-color: rgba(196, 30, 58, 0.25);
    transform: translateY(-3px);
  }
  .brand img {
    height: 30px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    transition: scale 0.25s ease;
  }
  .brand img.square {
    height: 46px;
    border-radius: 10px;
  }
  .brand:hover img {
    scale: 1.08;
  }
  .wordmark {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #9a9bab;
    transition: color 0.25s ease;
  }
  .brand:hover .wordmark {
    color: var(--dark);
  }
  @keyframes scroll {
    to { transform: translateX(calc(-50% - 10px)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      padding-inline: 20px;
    }
    .brand[aria-hidden='true'] {
      display: none;
    }
    .marquee {
      mask-image: none;
    }
  }
</style>
