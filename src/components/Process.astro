---
const svg = (body) => `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`

import { getLang } from '../i18n'

const lang = getLang(Astro.currentLocale)
const t = {
  fr: {
    eyebrow: 'Comment ça marche',
    title: ['Un processus ', 'simple et rapide'],
    lead: 'Trois étapes pour obtenir vos solutions bureautiques, sans prise de tête.',
    cta: 'Nous contacter',
    steps: [
      ['Contactez-nous', 'Rapide', 'Passez en boutique, appelez-nous, écrivez-nous par e-mail ou sur WhatsApp. Nous prenons le temps de comprendre votre besoin.'],
      ['Diagnostic & conseil', '24-48h', 'Nous analysons votre demande et vous conseillons la solution la plus adaptée, en toute transparence.'],
      ['Réalisation & suivi', 'Selon service', 'Notre équipe réalise votre commande avec soin et dans les délais, avec un suivi personnalisé.'],
    ],
  },
  en: {
    eyebrow: 'How it works',
    title: ['A ', 'simple, fast process'],
    lead: 'Three steps to get the office solutions you need, hassle-free.',
    cta: 'Contact us',
    steps: [
      ['Get in touch', 'Quick', 'Drop by the store, call us, or write to us by email or WhatsApp. We take the time to understand what you need.'],
      ['Diagnosis & advice', '24-48h', 'We look at your request and recommend the best-suited solution, with full transparency.'],
      ['Delivery & follow-up', 'Depends on service', 'Our team completes your order carefully and on time, with personal follow-up.'],
    ],
  },
}[lang]

const icons = [
  svg('<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>'),
  svg('<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>'),
  svg('<path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z"/>'),
]
const steps = t.steps.map(([title, time, text], i) => ({ title, time, text, icon: icons[i] }))
---

<section class="process">
  <div class="container">
    <header class="head reveal">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="section-title">{t.title[0]}<span>{t.title[1]}</span></h2>
      <p class="section-lead">{t.lead}</p>
    </header>

    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step reveal" style={`--delay: ${i * 120}ms`}>
          <div class="step-top">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="icon" set:html={s.icon}></span>
          </div>
          <div class="meta">
            <h3>{s.title}</h3>
            <span class="time">{s.time}</span>
          </div>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="cta reveal">
      <a href="#contact" class="btn btn-primary">{t.cta}</a>
    </div>
  </div>
</section>

<style>
  .process {
    padding-block: 96px;
    background: var(--light);
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 640px;
    margin: 0 auto 56px;
    text-align: center;
  }
  .steps {
    position: relative;
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .step:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .num {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    font-size: 20px;
    font-weight: 800;
    color: var(--white);
    background: var(--grad-primary);
    border-radius: 18px;
    box-shadow: 0 12px 24px rgba(196, 30, 58, 0.28);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--secondary);
    background: rgba(27, 94, 117, 0.08);
    border-radius: 14px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  h3 {
    font-size: 21px;
  }
  .time {
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
    color: var(--secondary);
    background: rgba(27, 94, 117, 0.08);
    border-radius: 999px;
    white-space: nowrap;
  }
  .step p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--text);
  }
  .cta {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }

  @media (min-width: 992px) {
    .process {
      padding-block: 120px;
    }
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
    .steps::before {
      content: '';
      position: absolute;
      z-index: -1;
      left: 10%;
      right: 10%;
      top: 56px;
      border-top: 2px dashed rgba(196, 30, 58, 0.25);
    }
  }
</style>
