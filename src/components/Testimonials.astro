---
import { GOOGLE_REVIEWS_URL } from '../config/contact'
import { getLang } from '../i18n'

const lang = getLang(Astro.currentLocale)
const t = {
  fr: {
    eyebrow: 'Avis clients',
    title: ['Ce que nos clients ', 'disent de nous'],
    allReviews: 'Voir tous nos avis Google',
    stars: (n) => `${n} étoiles sur 5`,
    source: 'Avis Google',
    ctaTitle: 'Vous êtes client de SBS ?',
    ctaText: 'Retrouvez tous nos avis sur notre fiche Google et partagez votre expérience.',
    ctaLink: 'Voir la fiche Google',
    quote: (s) => `« ${s} »`,
  },
  en: {
    eyebrow: 'Customer reviews',
    title: ['What our customers ', 'say about us'],
    allReviews: 'See all our Google reviews',
    stars: (n) => `${n} out of 5 stars`,
    source: 'Google review · translated from French',
    ctaTitle: 'Are you an SBS customer?',
    ctaText: 'Read all our reviews on our Google listing and share your experience.',
    ctaLink: 'View our Google listing',
    quote: (s) => `“${s}”`,
  },
}[lang]

const reviews = [
  {
    name: 'Adele M.',
    rating: 5,
    text: {
      fr: 'Je recommande vivement. L\'écran de mon téléphone ne s\'allumait plus. En une demi-heure le problème a été réglé… Vraiment très efficace… et en plus dans la bonne humeur.',
      en: 'I highly recommend them. My phone screen wouldn\'t turn on anymore. The problem was fixed in half an hour… Really very efficient… and with a smile, too.',
    }[lang],
  },
  {
    name: 'Simdia C.',
    rating: 5,
    text: {
      fr: 'Je recommande Sainte-Anne Bureautique.',
      en: 'I recommend Sainte-Anne Bureautique.',
    }[lang],
  },
]

const googleG = `<svg width="22" height="22" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.5-4.5 2.4-7.2 2.4-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>`
const initials = (n) => n.split(' ').map((p) => p[0]).join('').slice(0, 2)
---

<section class="testimonials" aria-labelledby="avis-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="container">
    <div class="head reveal">
      <div>
        <span class="eyebrow on-dark">{t.eyebrow}</span>
        <h2 id="avis-title" class="section-title">{t.title[0]}<span>{t.title[1]}</span></h2>
      </div>
      <a href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener" class="btn btn-white google-btn">
        <span set:html={googleG}></span>
        {t.allReviews}
      </a>
    </div>

    <div class="grid">
      {reviews.map((r, i) => (
        <figure class="review reveal" style={`--delay: ${i * 100}ms`}>
          <div class="review-top">
            <span class="stars" aria-label={t.stars(r.rating)}>{'★'.repeat(r.rating)}</span>
            <span class="source" set:html={googleG}></span>
          </div>
          <blockquote>
            <p>{t.quote(r.text)}</p>
          </blockquote>
          <figcaption>
            <span class="avatar" aria-hidden="true">{initials(r.name)}</span>
            <span>
              <strong>{r.name}</strong>
              <small>{t.source}</small>
            </span>
          </figcaption>
        </figure>
      ))}

      <a href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener" class="review review-cta reveal" style="--delay: 200ms">
        <span class="cta-g" set:html={googleG}></span>
        <strong>{t.ctaTitle}</strong>
        <p>{t.ctaText}</p>
        <span class="cta-link">{t.ctaLink} <span aria-hidden="true">↗</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .testimonials {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: 96px;
    color: var(--white);
    background: linear-gradient(155deg, #1f1f24 0%, #24242b 55%, #3a1a22 100%);
  }
  .glow {
    position: absolute;
    z-index: -1;
    width: 520px;
    height: 520px;
    right: -160px;
    top: -200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(196, 30, 58, 0.45), transparent 70%);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 48px;
  }
  .head .eyebrow {
    margin-bottom: 16px;
  }
  .section-title span {
    color: var(--primary-light);
  }
  .google-btn {
    color: var(--on-white);
  }
  .google-btn span {
    display: grid;
  }

  .grid {
    display: grid;
    gap: 20px;
  }
  .review {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 32px;
    background: var(--surface);
    color: var(--dark);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.25);
    transition: transform 0.3s ease;
  }
  .review:hover {
    transform: translateY(-6px);
  }
  .review-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .stars {
    font-size: 20px;
    letter-spacing: 3px;
    color: #f5b301;
  }
  .source {
    display: grid;
  }
  blockquote {
    margin: 0;
    flex: 1;
  }
  blockquote p {
    font-size: 18px;
    line-height: 1.55;
    font-weight: 500;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    font-size: 15px;
    font-weight: 700;
    color: var(--white);
    background: var(--grad-primary);
  }
  figcaption span:last-child {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  figcaption strong {
    font-size: 15px;
  }
  figcaption small {
    font-size: 13px;
    color: var(--muted);
  }

  .review-cta {
    justify-content: center;
    gap: 14px;
    color: var(--white);
    background: rgba(255, 255, 255, 0.06);
    border: 1px dashed rgba(255, 255, 255, 0.3);
    box-shadow: none;
  }
  .review-cta:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .cta-g {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--white);
  }
  .review-cta strong {
    font-size: 20px;
  }
  .review-cta p {
    font-size: 15px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
  }
  .cta-link {
    margin-top: 4px;
    font-weight: 600;
    color: var(--primary-light);
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .testimonials {
      padding-block: 120px;
    }
    .grid {
      grid-template-columns: 1.3fr 1fr 1fr;
    }
  }
</style>
