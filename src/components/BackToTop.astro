---
import { getLang } from '../i18n'

const label = { fr: 'Retour en haut de la page', en: 'Back to top' }[getLang(Astro.currentLocale)]
---

<button class="to-top" type="button" aria-label={label} title={label}>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.to-top')
  const update = () => btn?.classList.toggle('is-visible', window.scrollY > 600)
  update()
  window.addEventListener('scroll', update, { passive: true })
  const focusBrand = () => document.querySelector<HTMLElement>('.brand')?.focus({ preventScroll: true })
  btn?.addEventListener('click', () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduce || window.scrollY === 0) {
      window.scrollTo(0, 0)
      focusBrand()
      return
    }
    // Moving focus during a smooth scroll cancels it, so focus once we reach the top.
    window.addEventListener('scrollend', focusBrand, { once: true })
    window.scrollTo({ top: 0, behavior: 'smooth' })
  })
</script>

<style>
  .to-top {
    position: fixed;
    right: 25px;
    bottom: 92px;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    padding: 0;
    color: var(--white);
    background: var(--grad-primary);
    border: 0;
    border-radius: 50%;
    box-shadow: 0 12px 26px rgba(196, 30, 58, 0.35);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    translate: 0 16px;
    transition:
      opacity 0.3s ease,
      translate 0.3s ease,
      visibility 0.3s,
      box-shadow 0.2s ease;
  }
  .to-top.is-visible {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
  }
  .to-top:hover {
    translate: 0 -3px;
    box-shadow: 0 16px 32px rgba(196, 30, 58, 0.45);
  }
  .to-top:hover svg {
    animation: nudge 0.6s ease;
  }
  @keyframes nudge {
    50% { translate: 0 -3px; }
  }
  @media (min-width: 768px) {
    .to-top {
      right: 33px;
      bottom: 102px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .to-top,
    .to-top:hover svg {
      transition: none;
      animation: none;
    }
  }
</style>
